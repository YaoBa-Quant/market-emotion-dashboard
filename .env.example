# ===== 后端（Express 代理）=====

# Tushare Pro 接口令牌，必填。申请地址：https://tushare.pro/user/token
TUSHARE_TOKEN=replace_with_your_token

# 后端代理监听端口。修改后需同步修改 vite.config.js 中 /api 的 proxy target
SERVER_PORT=4174

# ===== 前端（Vite）=====

# 前端请求的后端地址，可选。留空时默认使用 http://127.0.0.1:4174/api
# 仅在前后端非同机部署时才需要填写
VITE_API_BASE_URL=
